{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "solfaflow-prototype",
      "runtimeExecutable": "prototype/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "server:app", "--app-dir", "prototype", "--port", "8765"],
      "env": { "SOLFAFLOW_LIST_ALL": "1" },
      "port": 8765
    },
    {
      "name": "vantly-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../vantly", "run", "dev", "--", "--port", "3000"],
      "port": 3000
    }
  ]
}
