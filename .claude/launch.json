{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vantly-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "vantly-dev-hosted-solfa",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3000"
      ],
      "env": {
        "NEXT_PUBLIC_SOLFA_URL": "https://victorfolorunsoofficial--solfaflow-web.us-east.modal.run"
      },
      "port": 3000
    },
    {
      "name": "vantly-dev-convert-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3000"
      ],
      "env": {
        "NEXT_PUBLIC_CONVERT_URL": "https://victorfolorunsoofficial--vantly-convert-web-dev.us-east.modal.run"
      },
      "port": 3000
    },
    {
      "name": "vantly-prod-build",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve@14.2.4",
        "out",
        "-l",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "solfa-api-local",
      "runtimeExecutable": "server/song-to-tonic-solfa/prototype/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "server:app",
        "--app-dir",
        "server/song-to-tonic-solfa/prototype",
        "--port",
        "8765"
      ],
      "env": {
        "SOLFAFLOW_LIST_ALL": "1"
      },
      "port": 8765
    }
  ]
}
